# Prometheus for the monitoring stack on Railway (railway.prometheus.toml).
# Root user because the Railway volume at /prometheus mounts root-owned and the
# stock image's nobody user cannot write it.
FROM prom/prometheus:v3.5.0@sha256:63805ebb8d2b3920190daf1cb14a60871b16fd38bed42b857a3182bc621f4996
USER root
COPY deploy/monitoring/prometheus/prometheus.yml /etc/prometheus/prometheus.yml
COPY deploy/monitoring/prometheus/entrypoint.sh /entrypoint.sh
EXPOSE 9090
ENTRYPOINT ["/bin/sh", "/entrypoint.sh"]
