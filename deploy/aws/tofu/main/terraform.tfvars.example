# Copy to terraform.tfvars (gitignored). NON-secret values only: every secret
# goes straight into Secrets Manager (README.md). Placeholders below are
# obviously fake; replace with the live Railway values (`railway variables -s
# <svc> --json`, never the truncating table view).

state_bucket      = "passband-tofu-state-000000000000"
state_kms_key_arn = "arn:aws:kms:us-west-2:000000000000:key/00000000-0000-0000-0000-000000000000"

budget_email = "ops@example.invalid"

# Leave false until every secret has a value and CI has pushed real images.
services_running = false

# control
control_base_domain = "passband.email"
control_client_id   = "000000000000-placeholder.apps.googleusercontent.com"
control_warden_url  = "https://warden.passband.app"
control_invite_from = "Passband <invites@passband.app>"
# control_llm_models       = "copy from Railway"
# control_assistant_models = "copy from Railway"
# control_llm_budget_usd       = "5.00"
# control_assistant_budget_usd = "10.00"

# relay
relay_apns_key_id  = "PLACEHOLDR"
relay_apns_team_id = "PLACEHOLDR"

# bifrost: "efs" (default) or "postgres", pending the Bifrost store finding.
bifrost_store = "efs"
