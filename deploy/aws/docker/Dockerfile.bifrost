# Bifrost for AWS (ECS service `bifrost`; deploy-aws.yml builds this file).
#
# The upstream image, pinned by DIGEST. Bifrost sees every mail body that
# goes to triage and holds the Anthropic key, so a re-pushed upstream tag
# must not reach production silently: the digest below is what gets pulled.
#
# Multi-arch index digest fetched from Docker Hub 2026-10-23. Bump the tag and
# the digest together.
#
# NOT root: the upstream image runs as
# 1000:0 (its appuser), and the data directory is an EFS access point that
# performs every operation as uid 1000 (tofu var.bifrost_uid) anyway, so the
# process and its files already agree. Root bought nothing here except a
# root process holding every mail body and the Anthropic key.
FROM maximhq/bifrost:v2.4.0@sha256:a1c90607dcfd13c1fb2f9476ceb3bb24407a50ade7fdf3e61a59fb42b09e5c57
EXPOSE 8080
