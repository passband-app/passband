<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Passband</string>
	<key>CFBundleIconFile</key>
	<string>Passband</string>
	<!-- The new-format icon compiled from ./Passband.icon into Assets.car;
	     without this name macOS 26 falls back to the icns and renders it
	     shrunken on a plain squircle as an unadopted legacy icon. -->
	<key>CFBundleIconName</key>
	<string>Passband</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- The git branch a dev build was cut from; build.sh fills it in and
	     leaves it empty for release builds and for main. An xcodebuild leaves
	     the setting undefined, which resolves to empty too. The masthead
	     shows it next to the sitrep label when non-empty (see SitrepView). -->
	<key>PassbandBuildBranch</key>
	<string>$(PASSBAND_BUILD_BRANCH)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string></string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSupportsAutomaticTermination</key>
	<true/>
	<key>NSSupportsSuddenTermination</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>ATSApplicationFontsPath</key>
	<string>Resources</string>
	<!-- passband://pair?url=…&amp;code=XXXX-XXXX — the deep link `squelchd pair`
	     prints, so a click carries the server URL and the one-shot pairing code
	     into the Connect gate. Handled in PassbandApp via onOpenURL; the link is
	     treated as untrusted input (see PairLink). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.passband.client.pair</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>passband</string>
			</array>
		</dict>
	</array>
	<!-- Sparkle auto-update. The feed is regenerated by the release pipeline;
	     the public key's private half lives in the signing keychain and CI
	     secrets — a compromised feed host cannot forge an update without it. -->
	<key>SUFeedURL</key>
	<string>https://passband.app/appcast.xml</string>
	<!-- Hourly, Sparkle's floor, rather than its daily default, so a release
	     reaches people within the hour. The feed is one static file; a check
	     costs the site nothing. -->
	<key>SUScheduledCheckInterval</key>
	<integer>3600</integer>
	<!-- Checks are on from first launch with no permission prompt: a check
	     sends nothing about the user (the system profile is never sent), and
	     an install that once answered "Don't Check" never updated again.
	     Updater.swift also forces both of these on every launch, because the
	     old answers persist in user defaults. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<true/>
	<key>SUPublicEDKey</key>
	<string>QqVsdIdhyz8E/iZ+ZhvwYe4aaQSMtIkObys6PYhFgkg=</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- The human door runs on http://127.0.0.1:8848 by default. Loopback
		     HTTP is permitted; everything else still requires TLS. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
