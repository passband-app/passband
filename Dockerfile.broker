# Builds squelch-broker — the consent relay. It is the second piece of squelch
# meant for shared/public infrastructure: its own service at
# auth.passband.email, separate from the APNs relay (see deploy/DEPLOY.md §8).
# The root Dockerfile builds the relay. The broker is not deployed anywhere
# today; this file is here for whoever deploys it.
#
# The build context must be the workspace root: squelch-broker is a workspace
# member and cargo needs the root manifest + lockfile to resolve it.

FROM rust:1-slim-bookworm@sha256:f2c004e3d2d8b547e8cf7ffbc29205385f4e71d23e53e4e383065db5e9f822cd AS builder
WORKDIR /build

# The compiler is rust-toolchain.toml's, not the image's; see that file's
# header for why, and for what a bump of it reaches.
COPY rust-toolchain.toml ./
RUN rustup toolchain install --no-self-update

COPY Cargo.toml Cargo.lock ./
COPY squelch-core ./squelch-core
COPY squelch-httpauth ./squelch-httpauth
COPY squelch-ratelimit ./squelch-ratelimit
COPY squelch-mcp ./squelch-mcp
COPY squelch-tui ./squelch-tui
COPY squelch-api ./squelch-api
COPY squelch-relay ./squelch-relay
COPY squelch-eval ./squelch-eval
COPY squelchd ./squelchd
COPY squelch-embed ./squelch-embed
COPY squelch-broker ./squelch-broker
# Hosted control plane + VPS provisioner. Neither ships in THIS image, but both
# are workspace members and cargo refuses to resolve the workspace without them.
COPY squelch-control ./squelch-control
COPY squelch-warden ./squelch-warden

RUN cargo build --release --locked -p squelch-broker

FROM debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3
# No ca-certificates, unlike the relay image: the broker makes no outbound
# request to anything. It never talks to Google — the daemon does the token
# exchange itself — and TLS on the way in is terminated by the platform edge.
RUN useradd --system --no-create-home broker

COPY --from=builder /build/target/release/squelch-broker /usr/local/bin/squelch-broker
COPY squelch-broker/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# No volume, no mount point, no chown: the only state this service has is a
# HashMap that lives for ten minutes, and an authorization code that survived a
# restart would be a liability, not a feature. So unlike the relay there is
# nothing that must happen as root, and the image never runs privileged even for
# the length of an entrypoint.
USER broker
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
